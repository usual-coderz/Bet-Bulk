from datetime import datetime, timezone


def now() -> datetime:
    return datetime.now(timezone.utc)


BASE_SELECTORS = {
    "form_ready": "input[type=tel]",
    "form_ready_alt": [
        "input[placeholder*='obile']",
        "input[placeholder*='hone']",
        "input[placeholder*='umber']",
